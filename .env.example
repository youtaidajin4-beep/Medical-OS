# Database
# ローカル（Docker Compose）:
DATABASE_URL="postgresql://medical_os:medical_os@localhost:5432/medical_os?schema=public"
# Staging / Production（Supabase 等）:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/medical_os?schema=public&sslmode=require"

# Backend
PORT=3001
JWT_SECRET="change-me-in-production"
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"
# 中身を先に作る単一医院開発モード。マルチテナント化時は false。
# クラウド本番（くしま内科パイロット）は false + ログイン必須。
SINGLE_CLINIC_MODE=true
SINGLE_CLINIC_PHYSICIAN_EMAIL="doctor@demo.clinic"

# Seed (local / first deploy)
SEED_PASSWORD="use-a-unique-password-at-least-8-chars"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_DEMO_MODE=false
# クラウド本番は false。ローカル単一医院のみ true。
NEXT_PUBLIC_SINGLE_CLINIC_MODE=true

# Storage (PR4+)
STORAGE_PROVIDER=local
# Railway Volume を使う場合はマウント先を指定（例: /data/audio）
STORAGE_PATH=
# local | minio
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="medical-os-audio"

# AI Providers (PR5+)
# Requires ffmpeg for multi-chunk recording: brew install ffmpeg
# OpenAI 実装時は両方 openai + OPENAI_API_KEY 必須（起動時に検証）
# パイロット（8/1）: openai を推奨
STT_PROVIDER=openai
# mock | openai
LLM_PROVIDER=openai
# mock | openai
OPENAI_API_KEY=
# STT: 本番既定は話者分離付き gpt-4o-transcribe-diarize。
# 障害時は OPENAI_STT_FALLBACK_MODEL（whisper-1）へ自動フォールバック。
# 話者分離が不要・品質比較時のみ OPENAI_WHISPER_MODEL=whisper-1 に戻す。
OPENAI_WHISPER_MODEL=gpt-4o-transcribe-diarize
OPENAI_STT_FALLBACK_MODEL=whisper-1
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_CORRECTION_MODEL=gpt-4o
# 書類生成は誤字脱字・転記精度を優先して gpt-4o を使用
OPENAI_DOCUMENT_MODEL=gpt-4o
