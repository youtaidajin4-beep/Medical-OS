# Railway production environment variables (set in Railway dashboard — do not commit secrets)
# See 07_ROADMAP/06_deploy_guide.md and 07_ROADMAP/07_kushima_production_connect.md
#
# Target:
# - Supabase: medical-os-kushima (fyzlcteanzwypisvztku) — internal medicine only
# - Railway Hobby service: medical-os-api (do not point at Bright Dental DB)
# - First tenant: clinics.code = kushima_internal

# Must be the medical-os-kushima Postgres URI (not dental / other projects)
DATABASE_URL=
JWT_SECRET=
NODE_ENV=production
FRONTEND_URL=https://medical-os-ruddy.vercel.app
# Production / multi-tenant deployments must keep this false.
SINGLE_CLINIC_MODE=false
SINGLE_CLINIC_PHYSICIAN_EMAIL=doctor@demo.clinic
STT_PROVIDER=openai
LLM_PROVIDER=openai
OPENAI_API_KEY=
# 話者分離付き最終STT（障害時は OPENAI_STT_FALLBACK_MODEL へフォールバック）
OPENAI_WHISPER_MODEL=gpt-4o-transcribe-diarize
OPENAI_STT_FALLBACK_MODEL=whisper-1
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_CORRECTION_MODEL=gpt-4o
OPENAI_DOCUMENT_MODEL=gpt-4o
STORAGE_PROVIDER=local
# Railway Volume 必須: サービスに Volume を追加し、マウントパスと揃える
STORAGE_PATH=/data/audio
