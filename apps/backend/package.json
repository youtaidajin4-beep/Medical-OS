{
  "name": "@medical-os/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "jest --config ./jest.config.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:local": "node scripts/start-local-postgres.mjs",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "ts-node prisma/seed.ts",
    "db:reset-pilot": "ts-node prisma/reset-pilot-data.ts",
    "set-password": "ts-node prisma/set-physician-password.ts",
    "db:update-glossary": "ts-node prisma/update-physician-glossary.ts",
    "db:suggest-replacements": "ts-node prisma/suggest-replacements.ts",
    "knowledge:generate": "ts-node scripts/medical-knowledge/generate-cases.ts",
    "knowledge:eval": "ts-node scripts/medical-knowledge/run-eval.ts",
    "knowledge:patch": "ts-node scripts/medical-knowledge/patch-from-failures.ts",
    "knowledge:loop": "ts-node scripts/medical-knowledge/eval-loop.ts",
    "knowledge:whisper-spot": "ts-node scripts/medical-knowledge/whisper-spotcheck.ts",
    "knowledge:patch-whisper": "ts-node scripts/medical-knowledge/patch-from-whisper.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@medical-os/shared": "workspace:*",
    "@medical-os/types": "workspace:*",
    "@nestjs/common": "^11.0.7",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.7",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.7",
    "@prisma/client": "^6.3.1",
    "argon2": "^0.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "nestjs-pino": "^4.3.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.2",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.7",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9.18.0",
    "ffmpeg-static": "^5.3.0",
    "jest": "^29.7.0",
    "prisma": "^6.3.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
