generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  PHYSICIAN
}

enum ConsultationStatus {
  DRAFT
  RECORDING
  PROCESSING
  REVIEW
  APPROVED
  COMPLETED
}

enum VisitType {
  ROUTINE
  CHECKUP
}

enum SpeakerLabel {
  PHYSICIAN
  PATIENT
  OTHER
  UNKNOWN
}

enum DocumentType {
  SOAP
  CLINICAL_NOTE
  TRANSCRIPT
  REFERRAL
  MEDICAL_CERTIFICATE
  CARE_OPINION_1
  CARE_OPINION_2
  PRESCRIPTION_LIST
  INFO_PROVIDE_COMBINED
}

enum GeneratedDocumentType {
  REFERRAL
  MEDICAL_CERTIFICATE
  CARE_OPINION_1
  CARE_OPINION_2
  PRESCRIPTION_LIST
  INFO_PROVIDE_COMBINED
}

enum WarningSeverity {
  INFO
  WARNING
  CRITICAL
}

model Clinic {
  id         String   @id @default(uuid())
  /** Stable tenant key within the internal-medicine Supabase project (e.g. kushima_internal). */
  code       String   @unique
  name       String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  users      User[]
  patients   Patient[]
  anonymousCases AnonymousCase[]
  clinicDictionaryTerms ClinicDictionaryTerm[]
  doctorDictionaryTerms DoctorDictionaryTerm[]
  transcriptCorrections TranscriptCorrection[]

  @@map("clinics")
}

model User {
  id           String    @id @default(uuid())
  clinicId     String    @map("clinic_id")
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  role               UserRole  @default(PHYSICIAN)
  status             String    @default("active")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  lastLogin          DateTime? @map("last_login")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  clinic       Clinic    @relation(fields: [clinicId], references: [id])
  consultations Consultation[] @relation("PhysicianConsultations")
  revisions    RevisionHistory[]
  auditLogs    AuditLog[]
  doctorDictionaryTerms DoctorDictionaryTerm[]
  transcriptCorrections TranscriptCorrection[]

  @@map("users")
}

model Patient {
  id          String   @id @default(uuid())
  clinicId    String   @map("clinic_id")
  patientCode String   @map("patient_code")
  name        String
  dateOfBirth DateTime? @map("date_of_birth")
  sex         String?
  phone       String?
  email       String?
  memo        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  clinic      Clinic   @relation(fields: [clinicId], references: [id])
  consultations Consultation[]

  @@unique([clinicId, patientCode])
  @@map("patients")
}

model AnonymousCase {
  id          String   @id @default(uuid())
  clinicId    String   @map("clinic_id")
  caseCode    String   @map("case_code")
  displayName String   @map("display_name")
  age         Int?
  sex         String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  clinic      Clinic   @relation(fields: [clinicId], references: [id])
  consultations Consultation[]

  @@unique([clinicId, caseCode])
  @@map("anonymous_cases")
}

model Consultation {
  id              String             @id @default(uuid())
  clinicId        String             @map("clinic_id")
  physicianId     String             @map("physician_id")
  patientId       String?            @map("patient_id")
  anonymousCaseId String?            @map("anonymous_case_id")
  status          ConsultationStatus @default(DRAFT)
  visitType       VisitType          @default(ROUTINE) @map("visit_type")
  startedAt       DateTime?          @map("started_at")
  endedAt         DateTime?          @map("ended_at")
  approvedAt      DateTime?          @map("approved_at")
  approvedById    String?            @map("approved_by_id")
  copiedAt        DateTime?          @map("copied_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  physician       User               @relation("PhysicianConsultations", fields: [physicianId], references: [id])
  patient         Patient?           @relation(fields: [patientId], references: [id])
  anonymousCase   AnonymousCase?     @relation(fields: [anonymousCaseId], references: [id])
  audioChunks     AudioChunk[]
  audioFiles      AudioFile[]
  transcriptSegments TranscriptSegment[]
  structuredData  StructuredClinicalData?
  warnings        ClinicalWarning[]
  soapDocuments   SoapDocument[]
  clinicalNotes   ClinicalNote[]
  generatedDocuments GeneratedDocument[]
  revisions       RevisionHistory[]
  aiExecutions    AIExecution[]
  chatMessages    ConsultationChatMessage[]
  attachments     ConsultationAttachment[]
  transcriptCorrections TranscriptCorrection[]
  clinicalEntities ClinicalEntity[]

  @@map("consultations")
}

model AudioChunk {
  id             String   @id @default(uuid())
  consultationId String   @map("consultation_id")
  sequenceNumber Int      @map("sequence_number")
  storageKey     String   @map("storage_key")
  checksum       String?
  uploadedAt     DateTime @default(now()) @map("uploaded_at")
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@unique([consultationId, sequenceNumber])
  @@map("audio_chunks")
}

model AudioFile {
  id             String    @id @default(uuid())
  consultationId String    @map("consultation_id")
  storageKey     String    @map("storage_key")
  durationSec    Int?      @map("duration_sec")
  deletedAt      DateTime? @map("deleted_at")
  deleteStatus   String?   @map("delete_status")
  createdAt      DateTime  @default(now()) @map("created_at")
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@map("audio_files")
}

model TranscriptSegment {
  id             String       @id @default(uuid())
  consultationId String       @map("consultation_id")
  sequenceNumber Int          @map("sequence_number")
  /// STT raw text — never overwrite after STT finalize
  rawText        String?      @map("raw_text")
  text           String
  normalizedText String?      @map("normalized_text")
  speaker        SpeakerLabel @default(UNKNOWN)
  confidence     Float?
  isFinal        Boolean      @default(false) @map("is_final")
  startMs        Int?         @map("start_ms")
  endMs          Int?         @map("end_ms")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@map("transcript_segments")
}

model StructuredClinicalData {
  id             String   @id @default(uuid())
  consultationId String   @unique @map("consultation_id")
  data           Json
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@map("structured_clinical_data")
}

model ClinicalWarning {
  id             String          @id @default(uuid())
  consultationId String          @map("consultation_id")
  category       String
  message        String
  severity       WarningSeverity @default(WARNING)
  resolved       Boolean         @default(false)
  createdAt      DateTime        @default(now()) @map("created_at")
  consultation   Consultation    @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@map("clinical_warnings")
}

model SoapDocument {
  id             String   @id @default(uuid())
  consultationId String   @map("consultation_id")
  subjective     String   @default("")
  objective      String   @default("")
  assessment     String   @default("")
  plan           String   @default("")
  version        Int      @default(1)
  isAiGenerated  Boolean  @default(true) @map("is_ai_generated")
  approved       Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@map("soap_documents")
}

model ClinicalNote {
  id             String   @id @default(uuid())
  consultationId String   @map("consultation_id")
  content        String   @default("")
  version        Int      @default(1)
  isAiGenerated  Boolean  @default(true) @map("is_ai_generated")
  approved       Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@map("clinical_notes")
}

model GeneratedDocument {
  id             String                @id @default(uuid())
  consultationId String                @map("consultation_id")
  type           GeneratedDocumentType
  content        Json
  version        Int                   @default(1)
  isAiGenerated  Boolean               @default(true) @map("is_ai_generated")
  approved       Boolean               @default(false)
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  consultation   Consultation          @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@index([consultationId, type])
  @@map("generated_documents")
}

model RevisionHistory {
  id             String       @id @default(uuid())
  consultationId String       @map("consultation_id")
  documentType   DocumentType @map("document_type")
  fieldName      String?      @map("field_name")
  beforeValue    String?      @map("before_value")
  afterValue     String?      @map("after_value")
  changedById    String       @map("changed_by_id")
  changedAt      DateTime     @default(now()) @map("changed_at")
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  changedBy      User         @relation(fields: [changedById], references: [id])

  @@map("revision_history")
}

model AIExecution {
  id             String   @id @default(uuid())
  consultationId String   @map("consultation_id")
  step           String
  provider       String
  promptVersion  String?  @map("prompt_version")
  inputTokens    Int?     @map("input_tokens")
  outputTokens   Int?     @map("output_tokens")
  durationMs     Int?     @map("duration_ms")
  status         String
  errorMessage   String?  @map("error_message")
  createdAt      DateTime @default(now()) @map("created_at")
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@map("ai_executions")
}

model PromptVersion {
  id        String   @id @default(uuid())
  name      String
  version   String
  content   String
  isActive  Boolean  @default(false) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([name, version])
  @@map("prompt_versions")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model UserSettings {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  settings  Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_settings")
}

model ConsultationChatMessage {
  id             String   @id @default(uuid())
  consultationId String   @map("consultation_id")
  role           String
  content        String
  createdAt      DateTime @default(now()) @map("created_at")
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@index([consultationId, createdAt])
  @@map("consultation_chat_messages")
}

model ConsultationAttachment {
  id             String   @id @default(uuid())
  consultationId String   @map("consultation_id")
  fileName       String   @map("file_name")
  mimeType       String   @map("mime_type")
  storageKey     String   @map("storage_key")
  ocrText        String?  @map("ocr_text")
  documentKind   String   @default("other") @map("document_kind")
  createdAt      DateTime @default(now()) @map("created_at")
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@index([consultationId, createdAt])
  @@map("consultation_attachments")
}

// ─── Medical Knowledge Layer (STT correction / normalization only — not diagnosis AI) ───

enum MedicalTermCategory {
  diagnosis
  symptom
  finding
  medication
  dosage
  strength
  unit
  route
  frequency
  duration
  laboratory_test
  laboratory_value
  vital_sign
  imaging
  procedure
  allergy
  body_part
  body_side
  negation
  treatment_action
  hospital_name
  doctor_name
  date
  time
  abbreviation
  other
}

enum MedicalTermAliasType {
  spoken
  abbreviation
  brand_name
  generic_name
  common_misspelling
  stt_error
  legacy
  english
}

enum MedicalKnowledgeSource {
  national_master_import
  internal_medicine_seed
  clinic
  physician
  learning_candidate
}

enum MedicalRiskLevel {
  low
  medium
  high
  critical
}

enum KnowledgeSpecialty {
  internal_medicine
  dentistry
  orthopedics
  dermatology
  psychiatry
  care
  general
}

/// LEVEL 1–2 shared medical terms (national import + specialty seeds). Codes must come from masters — never LLM-invented.
model MedicalTerm {
  id            String               @id @default(uuid())
  canonicalName String               @map("canonical_name")
  reading       String?
  category      MedicalTermCategory
  subcategory   String?
  englishName   String?              @map("english_name")
  abbreviation  String?
  specialty     KnowledgeSpecialty   @default(internal_medicine)
  priority      Int                  @default(100)
  riskLevel     MedicalRiskLevel     @default(medium) @map("risk_level")
  source        MedicalKnowledgeSource @default(internal_medicine_seed)
  /// Official master code when verified (YLCM/HOT/JLAC/etc). Null if unverified — never invent.
  sourceCode    String?              @map("source_code")
  isActive      Boolean              @default(true) @map("is_active")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  aliases       MedicalTermAlias[]

  @@index([canonicalName])
  @@index([category, specialty, isActive])
  @@index([reading])
  @@map("medical_terms")
}

model MedicalTermAlias {
  id            String               @id @default(uuid())
  medicalTermId String               @map("medical_term_id")
  alias         String
  aliasReading  String?              @map("alias_reading")
  aliasType     MedicalTermAliasType @map("alias_type")
  medicalTerm   MedicalTerm          @relation(fields: [medicalTermId], references: [id], onDelete: Cascade)

  @@index([alias])
  @@index([medicalTermId])
  @@map("medical_term_aliases")
}

/// LEVEL 3 clinic-specific dictionary
model ClinicDictionaryTerm {
  id           String              @id @default(uuid())
  clinicId     String              @map("clinic_id")
  canonicalName String             @map("canonical_name")
  reading      String?
  category     MedicalTermCategory @default(other)
  aliases      Json                @default("[]")
  frequency    Int                 @default(0)
  priority     Int                 @default(100)
  isActive     Boolean             @default(true) @map("is_active")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  clinic       Clinic              @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, isActive])
  @@index([clinicId, canonicalName])
  @@map("clinic_dictionary_terms")
}

/// LEVEL 4 physician-specific dictionary
model DoctorDictionaryTerm {
  id                   String   @id @default(uuid())
  clinicId             String   @map("clinic_id")
  physicianId          String   @map("physician_id")
  canonicalName        String   @map("canonical_name")
  spokenForm           String   @map("spoken_form")
  preferredWrittenForm String   @map("preferred_written_form")
  frequency            Int      @default(0)
  priority             Int      @default(100)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  clinic               Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  physician            User     @relation(fields: [physicianId], references: [id], onDelete: Cascade)

  @@index([physicianId])
  @@index([clinicId, physicianId])
  @@map("doctor_dictionary_terms")
}

model TranscriptCorrection {
  id                String              @id @default(uuid())
  clinicId          String              @map("clinic_id")
  physicianId       String?             @map("physician_id")
  consultationId    String              @map("consultation_id")
  rawText           String              @map("raw_text")
  correctedText     String              @map("corrected_text")
  originalTerm      String?             @map("original_term")
  correctedTerm     String?             @map("corrected_term")
  category          MedicalTermCategory?
  confidence        Float?
  correctionSource  String              @map("correction_source")
  approvedByDoctor  Boolean             @default(false) @map("approved_by_doctor")
  createdAt         DateTime            @default(now()) @map("created_at")
  clinic            Clinic              @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  physician         User?               @relation(fields: [physicianId], references: [id])
  consultation      Consultation        @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@index([consultationId])
  @@index([clinicId, originalTerm, correctedTerm])
  @@map("transcript_corrections")
}

model ClinicalEntity {
  id               String              @id @default(uuid())
  consultationId   String              @map("consultation_id")
  entityType       MedicalTermCategory @map("entity_type")
  rawValue         String              @map("raw_value")
  normalizedValue  String?             @map("normalized_value")
  confidence       Float?
  startPosition    Int?                @map("start_position")
  endPosition      Int?                @map("end_position")
  needsReview      Boolean             @default(false) @map("needs_review")
  riskLevel        MedicalRiskLevel    @default(medium) @map("risk_level")
  createdAt        DateTime            @default(now()) @map("created_at")
  consultation     Consultation        @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  candidates       EntityCandidate[]

  @@index([consultationId])
  @@index([consultationId, needsReview])
  @@map("clinical_entities")
}

model EntityCandidate {
  id               String         @id @default(uuid())
  clinicalEntityId String         @map("clinical_entity_id")
  candidateValue   String         @map("candidate_value")
  score            Float
  candidateSource  String         @map("candidate_source")
  clinicalEntity   ClinicalEntity @relation(fields: [clinicalEntityId], references: [id], onDelete: Cascade)

  @@index([clinicalEntityId])
  @@map("entity_candidates")
}

model KnowledgeQualityMetric {
  id                          String   @id @default(uuid())
  consultationId              String   @unique @map("consultation_id")
  generalTranscriptionAccuracy Float?  @map("general_transcription_accuracy")
  medicalTermAccuracy         Float?   @map("medical_term_accuracy")
  medicationAccuracy          Float?   @map("medication_accuracy")
  dosageAccuracy              Float?   @map("dosage_accuracy")
  laboratoryAccuracy          Float?   @map("laboratory_accuracy")
  numericAccuracy             Float?   @map("numeric_accuracy")
  negationAccuracy            Float?   @map("negation_accuracy")
  doctorCorrectionCount       Int      @default(0) @map("doctor_correction_count")
  automaticCorrectionCount    Int      @default(0) @map("automatic_correction_count")
  reviewRequiredCount         Int      @default(0) @map("review_required_count")
  criticalMedicalErrorCount   Int      @default(0) @map("critical_medical_error_count")
  createdAt                   DateTime @default(now()) @map("created_at")
  updatedAt                   DateTime @updatedAt @map("updated_at")

  @@map("knowledge_quality_metrics")
}

/// Learning candidates promoted from repeated corrections — require admin approval before clinic dictionary insert
model DictionaryLearningCandidate {
  id            String              @id @default(uuid())
  clinicId      String              @map("clinic_id")
  originalTerm  String              @map("original_term")
  correctedTerm String              @map("corrected_term")
  category      MedicalTermCategory?
  occurrenceCount Int               @default(1) @map("occurrence_count")
  status        String              @default("pending") // pending | approved | rejected
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  @@unique([clinicId, originalTerm, correctedTerm])
  @@index([clinicId, status])
  @@map("dictionary_learning_candidates")
}
